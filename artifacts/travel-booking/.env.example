# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — development-only environment variables
#
# Copy to .env.local for local dev:
#   cp .env.example .env.local
#
# In production the frontend is served as static files from dist/public/
# by the Express API server — no Vite env vars are needed at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# API base URL for local development (proxied by Vite)
# In production this is handled by Express serving the built files.
VITE_API_BASE_URL=http://localhost:8080
