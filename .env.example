# ─────────────────────────────────────────────────────────────────────────────
# Dream Fly Global — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# .env is git-ignored and stays on the server only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (DigitalOcean Managed PostgreSQL) ────────────────────────────────
# Find this in: DO Console → Databases → your cluster → Connection Details
# Use the "Connection string" (URI) format.  Add ?sslmode=require at the end.
DATABASE_URL=postgresql://doadmin:CHANGE_ME@db-postgresql-xxx.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── TripJack (Flights) ────────────────────────────────────────────────────────
TRIPJACK_API_KEY=
TRIPJACK_BASE_URL=https://apitest.tripjack.com

# ── HotelBeds ─────────────────────────────────────────────────────────────────
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=

# ── Twilio (WhatsApp marketing) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
