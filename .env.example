# ─────────────────────────────────────────────────────────────────────────────
# Dream Fly Global — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# .env is git-ignored and lives on the server only — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (DigitalOcean Managed Database → Connection Details)
DATABASE_URL=

PORT=3000
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Master admin login for /master-admin/login
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# ── Logging ───────────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ── TripJack (Flights API) ────────────────────────────────────────────────────
#
# IMPORTANT — use matching key + URL pair:
#
#   Sandbox (test)  → TRIPJACK_BASE_URL=https://apitest.tripjack.com
#                     Use your TripJack sandbox/test API key
#
#   Production      → TRIPJACK_BASE_URL=https://api.tripjack.com
#                     Use your TripJack production API key
#
# Mixing a production key with the sandbox URL (or vice versa) causes
# "Unauthorized Access! The provided API key is invalid."
#
# After changing either value, restart the server so dotenv reloads.
#
# To verify what is loaded on any server, hit:
#   curl https://your-server.com/api/tripjack-diag
# ─────────────────────────────────────────────────────────────────────────────

TRIPJACK_API_KEY=
TRIPJACK_BASE_URL=https://api.tripjack.com

# ── HotelBeds ─────────────────────────────────────────────────────────────────

HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Razorpay (Payments) ───────────────────────────────────────────────────────

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
